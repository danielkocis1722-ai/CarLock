<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <application>

        <activity
            android:name=".CarlockNfcSetupActivity"
            android:exported="false" />

        <activity
            android:name=".CarlockNfcActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/carlock_nfc_techs" />
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".CarlockBluetoothReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.bluetooth.device.action.ACL_CONNECTED" />

                <action
                    android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />

                <action
                    android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />

                <action
                    android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />

                <action
                    android:name="android.bluetooth.adapter.action.STATE_CHANGED" />

            </intent-filter>

        </receiver>

        <receiver
            android:name=".CarlockReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
    android:name=".CarlockNotificationActionReceiver"
    android:enabled="true"
    android:exported="false" />

    </application>

</manifest>
